{
  "name": "server",
  "version": "1.0.0",
  "description": "Backend API for College Admission Management Desktop System",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seed.js"
  },
  "pkg": {
    "assets": [
      "uploads/**/*",
      "../frontend/dist/**/*"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "../dist"
  },
  "dependencies": {
    "@seald-io/nedb": "^4.1.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.1",
    "multer": "^1.4.5-lts.1",
    "nedb-promises": "^6.2.3",
    "pdfkit": "^0.19.1",
    "sequelize": "^6.37.8",
    "sqlite3": "^5.1.7",
    "tedious": "^19.2.1"
  },
  "optionalDependencies": {
    "msnodesqlv8": "^5.2.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
